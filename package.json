{
  "name": "cpsc581-a2-expertise-sharing",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w apps/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
